# Copy this to .env and fill in real values. Never commit .env to git.

PORT=3001

# Supabase (https://supabase.com/dashboard → Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# 32-byte hex key for AES-256-GCM — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-64-hex-chars

# Your deployed Vercel frontend URL (no trailing slash)
FRONTEND_URL=https://reading-rocket.vercel.app
